# Marketing site build-time env (set in the Vercel "stayvia-marketing"
# project → Settings → Environment Variables, Production).
#
# The landing page bakes this at build time to point every "Start free trial"
# / "Sign in" CTA at the product app. Vite only reads VITE_* vars.

# Where the product app lives. The app stays on the root domain; marketing
# lives on stayviawebsite.infynarc.com.
VITE_APP_URL=https://stayvia.infynarc.com
